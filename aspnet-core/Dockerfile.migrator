# Stage 1: Build the DbMigrator
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /app

# Copy everything and restore
COPY . .
RUN dotnet restore "src/LuftBornTask.DbMigrator/LuftBornTask.DbMigrator.csproj"

# Publish the DbMigrator
RUN dotnet publish "src/LuftBornTask.DbMigrator/LuftBornTask.DbMigrator.csproj" -c Release -o /app/publish

# Stage 2: Runtime
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app

COPY --from=build /app/publish .

ENTRYPOINT ["dotnet", "LuftBornTask.DbMigrator.dll"]
